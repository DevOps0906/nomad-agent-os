#!/usr/bin/env bash
# oss — 오픈소스/로컬 LLM(Ollama · LM Studio · vLLM 등 OpenAI 호환 API)에 단순 텍스트 작업을 맡긴다.
#   사용: oss "<지시>" [파일...] [-o 결과파일]
#   예)  oss "실패 원인을 3줄로 요약" .nomad/logs/x.log
#        oss "이 diff로 한국어 커밋 메시지 1줄" <(git diff --staged) -o .nomad/commit.txt
#   환경: NOMAD_OSS_URL   (기본 http://localhost:11434/v1  ← Ollama)
#         NOMAD_OSS_MODEL (기본 qwen3-coder)     NOMAD_OSS_KEY (필요 시)
#         NOMAD_OSS_MAXCHARS (입력 상한, 기본 60000)
# 맞는 일: 로그 요약 · 값 추출 · 번역 · 커밋 메시지 · Mermaid 초안 · 분류. 맞지 않는 일: 설계 판단 · 보안 검토.
# 결과는 파일로 받고, 팀장은 결과 파일만 읽는다(유료 모델 토큰 0).
set -u
URL=${NOMAD_OSS_URL:-http://localhost:11434/v1}; MODEL=${NOMAD_OSS_MODEL:-qwen3-coder}
MAXC=${NOMAD_OSS_MAXCHARS:-60000}; OUT=""; FILES=()
[ $# -eq 0 ] && { sed -n '2,12p' "$0"; exit 2; }
PROMPT="$1"; shift
while [ $# -gt 0 ]; do [ "$1" = "-o" ] && { shift; OUT="$1"; } || FILES+=("$1"); shift; done
PY=""; for c in python3 python; do "$c" -c "import sys; sys.exit(sys.version_info < (3, 8))" >/dev/null 2>&1 && { PY=$c; break; }; done
[ -n "$PY" ] || { echo "❌ Python 3.8+ 필요"; exit 1; }
export PYTHONUTF8=1 PYTHONIOENCODING=utf-8
BODY=$($PY - "$PROMPT" "$MODEL" "$MAXC" "${FILES[@]+"${FILES[@]}"}" <<'PYEOF'
import json, sys
prompt, model, maxc, files = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4:]
ctx = ""
for f in files:
    try:
        with open(f, encoding="utf-8", errors="replace") as fh: ctx += f"\n\n### {f}\n" + fh.read()
    except OSError as e: ctx += f"\n\n### {f}\n(읽기 실패: {e})"
if len(ctx) > maxc: ctx = ctx[:maxc] + "\n...(잘림)"
print(json.dumps(ensure_ascii=False, obj={"model": model, "temperature": 0.2, "stream": False,
  "messages": [{"role": "system", "content": "한국어로 간결하게 답한다. 요청한 형식만 출력한다."},
               {"role": "user", "content": prompt + ctx}]}))
PYEOF
)
# 본문은 stdin(--data-binary @-)으로 — 명령줄 길이 제한(Windows 32K)에 걸리지 않게
RESP=$(printf '%s' "$BODY" | curl -sS --max-time 600 "$URL/chat/completions" -H "Content-Type: application/json; charset=utf-8" \
  ${NOMAD_OSS_KEY:+-H "Authorization: Bearer $NOMAD_OSS_KEY"} --data-binary @- 2>&1) || { echo "❌ 요청 실패: $URL — $RESP (ollama serve 실행 · NOMAD_OSS_URL 확인)"; exit 1; }
TEXT=$(printf '%s' "$RESP" | $PY -c 'import json,sys
d=json.load(sys.stdin)
if "choices" in d: print(d["choices"][0]["message"]["content"].strip())
else: print("❌ 응답 오류:", d); sys.exit(1)') || { echo "$TEXT"; exit 1; }
if [ -n "$OUT" ]; then mkdir -p "$(dirname "$OUT")"; printf '%s\n' "$TEXT" >"$OUT"; echo "✅ $OUT ($(wc -c <"$OUT" | tr -d ' ')B, model=$MODEL)"
else printf '%s\n' "$TEXT"; fi
