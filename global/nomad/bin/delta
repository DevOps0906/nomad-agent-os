#!/usr/bin/env bash
# delta — "새로 추가되거나 바뀐 줄만" 본다. 처음부터 다시 읽지 않기 위한 도구(모든 AI 도구·사람용).
#   delta <파일...>                 마지막으로 delta로 본 뒤 바뀐 줄(덧붙임이면 새 줄만)
#   delta --changed [--since REF]   체크포인트 이후 바뀐 파일 목록(새 세션 재진입용)
#   delta --checkpoint              지금 상태를 체크포인트로 저장(작업 끝에)
# Claude Code 안에서는 readguard 훅이 같은 일을 자동으로 한다(바뀐 파일을 다시 Read 하면 바뀐 줄만 전달).
exec bash "$(cd "$(dirname "$0")" && pwd)/_py" readguard delta "$@"
